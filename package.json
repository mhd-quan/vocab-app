{
  "name": "vocab-app",
  "version": "0.13.5",
  "description": "Interactive vocabulary & grammar tutoring platform for Destination B1/B2",
  "main": ".vite/build/main.js",
  "private": true,
  "author": {
    "name": "mhd-quan"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:artifacts": "tsx scripts/verify-package-artifacts.ts",
    "build:icons": "tsx scripts/build-app-icons.ts",
    "build:windows-installers": "tsx scripts/build-windows-installers.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "tsx scripts/migrate-dev.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "import": "VOCAB_DB_PATH=\"$HOME/Library/Application Support/vocab-app/vocab.dev.db\" ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/import-content.ts",
    "import:watch": "VOCAB_DB_PATH=\"$HOME/Library/Application Support/vocab-app/vocab.dev.db\" ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/import-content.ts --watch",
    "import:dry-run": "VOCAB_DB_PATH=\"$HOME/Library/Application Support/vocab-app/vocab.dev.db\" ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/import-content.ts --dry-run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.16",
    "@tanstack/react-router": "^1.95.1",
    "better-sqlite3": "^11.7.0",
    "canvas-confetti": "^1.9.4",
    "chokidar": "^4.0.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.2",
    "electron-squirrel-startup": "^1.0.1",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electron-forge/cli": "^7.5.0",
    "@electron-forge/maker-deb": "^7.5.0",
    "@electron-forge/maker-dmg": "^7.5.0",
    "@electron-forge/maker-squirrel": "^7.5.0",
    "@electron-forge/maker-zip": "^7.5.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.5.0",
    "@electron-forge/plugin-fuses": "^7.5.0",
    "@electron-forge/plugin-vite": "^7.5.0",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^3.7.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/canvas-confetti": "^1.9.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "electron": "^33.2.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
